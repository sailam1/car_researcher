# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Main chat / discovery — https://openrouter.ai/qwen/qwen3-8b
OPENROUTER_CHAT_MODEL=qwen/qwen3-8b
# Router, SQL, structured tasks — https://openrouter.ai/qwen/qwen3-coder-next
OPENROUTER_FAST_MODEL=qwen/qwen3-coder-next
OPENROUTER_EMBED_MODEL=openai/text-embedding-3-small
LLM_TEMP_SESSION_MANAGER=0.5
LLM_TEMP_QUESTION_GENERATOR=0.7
LLM_TEMP_WELCOME=0.6
LLM_TEMP_ROUTER=0.1
LLM_TEMP_SQL=0.1
CHECKPOINT_DB_PATH=./runtime/checkpoints.db
SESSION_DB_PATH=./runtime/sessions.db
DUCKDB_PATH=./runtime/cardeko.duckdb
# true avoids cardeko.duckdb lock issues on Windows / uvicorn --reload
DUCKDB_IN_MEMORY=true
DUCKDB_FALLBACK_MEMORY=true
CARDATA_DIR=../cardata
# Comma-separated browser origins allowed to call the API (required for Netlify → Render)
# Replace with your real Netlify URL, e.g. https://cardeko.netlify.app
CORS_ORIGINS=http://localhost:5173,https://YOUR-SITE.netlify.app
